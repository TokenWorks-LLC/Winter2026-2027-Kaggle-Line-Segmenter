.DS_Store
.venv
__pycache__/
savio

# Model weights stay out of git (published on Kaggle). The default run's small files are tracked.
weights/*
!weights/linemodel/
weights/linemodel/*
!weights/linemodel/run6_heights_s1/
weights/linemodel/run6_heights_s1/*.pt

# Raw downloads (see README: "Getting the data"). signs_snippets_metadata.json is small and stays tracked.
data/cdli/
data/ebl/*
!data/ebl/signs_snippets_metadata.json
data/fonts/
data/heidelberg/
data/Test Files
external/

# Working data, predictions and exports. A sample of the line dataset is in examples/; the full set is on Kaggle.
tablet_data/*
output/
!tablet_data/line_model_training_faces.csv
weights/linemodel/run6_heights_s1/*.log
